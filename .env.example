# ─────────────────────────────────────────────────────────────────────────────
# Cambio configuration. Copy to .env.local (frontend, Vite) or set in your host.
# Never commit real secrets. Nothing here is a private key: Cambio is non-custodial.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (baked into the build by Vite; public by design) ────────────────

# Reown (WalletConnect) project ID. Required for any deployed build.
# Create one at https://cloud.reown.com and allow-list your deployment origin.
VITE_WALLETCONNECT_PROJECT_ID="YOUR_REOWN_PROJECT_ID"

# Mezo Mainnet carries REAL funds. Off by default; only Mezo Testnet is offered.
# Set to "true" only after you have reviewed the risks in README → Residual risks.
VITE_ENABLE_MAINNET="false"

# ── Server (server.js / Cloud Run) ───────────────────────────────────────────

# Public origin of the deployment. Used as the domain the wallet signs for (EIP-4361).
# Set this explicitly on your host; do not assume a platform injects it.
# If unset, the request's Host is used (suitable for local evaluation only).
APP_URL="https://your-app.example.com"

# Port to listen on (Cloud Run sets this).
PORT="3000"

# Identity (username) registry store: "firestore" (default in production) or "memory".
# "memory" is NOT durable and NOT shared across instances; production refuses it unless
# ALLOW_NON_DURABLE_IDENTITY="true" is also set (useful for a throwaway demo deployment).
IDENTITY_STORE="firestore"
ALLOW_NON_DURABLE_IDENTITY="false"

# Firestore target. Defaults come from firebase-applet-config.json.
FIREBASE_PROJECT_ID=""
FIRESTORE_DATABASE_ID=""

# Credentials: on Cloud Run the service account is used automatically (Application Default
# Credentials). Locally, point this at a service-account JSON file kept OUTSIDE the repo,
# or use the emulator instead (FIRESTORE_EMULATOR_HOST="127.0.0.1:8085").
GOOGLE_APPLICATION_CREDENTIALS=""
FIRESTORE_EMULATOR_HOST=""

# Comma-separated extra origins allowed to call /api cross-origin. Leave empty for same-origin only.
ALLOWED_ORIGINS=""

# Number of trusted proxy hops. Default 0 for direct Node hosting; set 1 only behind
# exactly one trusted proxy (for example a correctly configured Cloud Run ingress).
# Firestore-backed identity also shares atomic rate limits across instances.
TRUST_PROXY="0"
